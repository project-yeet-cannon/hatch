<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The runner: `hatch work` and `hatch go-to-work`, which are the two commands
    that spawn an agent and therefore the two that hold a claim.

    A program rather than a shell function because of what these do rather than
    what they say. A claim is a lease with a clock on it, and the code around
    one is a race, a background heartbeat and three signals - none of which a
    2,500-line bash script can be tested for on any machine in this house. The
    conversational half of the CLI is still `scripts/hatch.sh`; see docs/hatch.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aerie.Hatch</RootNamespace>
    <AssemblyName>hatch-runner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aerie.Hatch.Contracts/Aerie.Hatch.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aerie.Hatch.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aerie.Hatch.Tests" />
  </ItemGroup>

</Project>
