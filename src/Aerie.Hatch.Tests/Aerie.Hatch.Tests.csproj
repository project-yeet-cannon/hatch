<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the shell could not have. The runner's failure modes are races,
    signals and a background clock - two runners reaching for one ticket, a
    lease that goes while a session is spending money, an interrupt between a
    claim and its release - and every one of them is asserted here, offline,
    against a stub wire and a stub session.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Aerie.Hatch.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      Dynamic skipping. Two facts about a checkout are properties of the
      filesystem underneath it rather than of this code - whether it folds case,
      and whether it will make a symlink without asking for a privilege - and a
      test that asserted either everywhere would be red on somebody's CI for a
      reason that is not a defect.
    -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aerie.Hatch/Aerie.Hatch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Aerie.Hatch" />
    <Using Include="Aerie.Hatch.Contracts" />
  </ItemGroup>

</Project>
