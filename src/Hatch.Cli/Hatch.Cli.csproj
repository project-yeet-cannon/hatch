<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `hatch`: the whole CLI, as one program.

    It began as `work` and `go-to-work` alone, because of what those two do
    rather than what they say - a claim is a lease with a clock on it, and the
    code around one is a race, a background heartbeat and three signals, none of
    which a 2,500-line bash script can be tested for on any machine in this
    house.

    AERIE-934 brought the other fourteen commands across for a different reason.
    An operator who is not in this repository has no scripts/hatch.sh, and a
    tracker reachable from one clone is a tracker for one person. So this
    publishes as a single self-contained binary named `hatch` for four
    platforms - see `make publish-hatch` - and scripts/hatch.sh is a door into
    it. docs/hatch.md, "Where the loop lives".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hatch.Cli</RootNamespace>
    <AssemblyName>hatch</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Only when a RID was asked for, which is `make publish-hatch` and nothing
    else. `dotnet build` and `dotnet test` run RID-less everywhere - in CI, in
    `make build-hatch`, and on the restart path scripts/hatch.sh takes at two in
    the morning - and trimming a build nobody is shipping would make all three
    slower for nothing.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!--
      No .pdb beside the binary. A published RID is something somebody
      downloads - from `make publish-hatch`, from the image's own build, or
      from CI's hatch-cli job - and a symbol file is 156KB of nothing they
      asked for sitting next to it, which the Runner page would then have to
      know not to serve. Set here rather than in the three callers so there is
      one place it is true.
    -->
    <DebugType>none</DebugType>
    <!--
      And none from the project reference either. DebugType is per-project, so
      without this Hatch.Contracts.pdb lands beside the binary - the
      referenced project still wants symbols wherever Hatch.Api builds it.
    -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hatch.Contracts/Hatch.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Hatch.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hatch.Cli.Tests" />
  </ItemGroup>

</Project>
