{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Local dev defaults, not production credentials. `db` is the container in
  // the root compose.yaml, and these two strings only ever resolve there. The
  // cluster reads this same file and overrides both with ConnectionStrings__*
  // env vars sourced from CNPG's own generated Secret, so nothing here reaches
  // a deployed installation. (The cluster plan Phase 7b.9 kept them for this
  // reason after deleting the rest of the compose path.)
  "ConnectionStrings": {
    "Aerie": "Host=db;Database=aerie;Username=user;Password=password",
    "Quartz": "Host=db;Database=quartz;Username=user;Password=password"
  },
  "Docs": {
    "Path": "docs"
  }
}
