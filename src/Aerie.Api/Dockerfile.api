# Build the SPAs (Aerie.Web/apps/*) separately - the .NET SDK image has no Node
# runtime, and their outputs are committed to wwwroot/apps/* as static web
# assets of Aerie.Api.
#
# One stage, not one per app. Aerie.Web is an npm workspace with a single
# hoisted lockfile, so per-app stages could no longer cache independently
# anyway: any app's dependency change rewrites the one lockfile and busts every
# stage's `npm ci`. Six stages would pay the install cost six times to buy
# nothing; this pays it once.
#
# AERIE_REVISION/AERIE_SEQUENCE are the git identity of this build (see
# docs/plans/version.md). This stage takes them because
# ../Aerie.Web/vite-plugin-aerie-revision.mts stamps them into each app's
# index.html; the SDK stage takes them because the API reads its own out of the
# assembly. Declared per stage rather than once at the top: a build arg is
# scoped to the stage that declares it, and a global ARG before the first FROM
# is *not* inherited by the stages below it.
#
# The ARG lines sit after `npm ci` on purpose. A build arg only invalidates the
# layers that reference it, so a new commit rebuilds index.html without
# re-resolving the dependency tree.
FROM node:22-alpine AS web-build
WORKDIR /repo

# Every workspace's package.json is an input to `npm ci`, so they are copied
# ahead of the sources: an edit to any app's *code* then reuses this layer.
COPY src/Aerie.Web/package.json src/Aerie.Web/package-lock.json src/Aerie.Web/
COPY src/Aerie.Web/apps/admin/package.json src/Aerie.Web/apps/admin/
COPY src/Aerie.Web/apps/auth/package.json src/Aerie.Web/apps/auth/
COPY src/Aerie.Web/apps/chrome/package.json src/Aerie.Web/apps/chrome/
COPY src/Aerie.Web/apps/dashboard/package.json src/Aerie.Web/apps/dashboard/
COPY src/Aerie.Web/apps/design/package.json src/Aerie.Web/apps/design/
COPY src/Aerie.Web/apps/docs/package.json src/Aerie.Web/apps/docs/
COPY src/Aerie.Web/apps/family/package.json src/Aerie.Web/apps/family/
COPY src/Aerie.Web/apps/hatch/package.json src/Aerie.Web/apps/hatch/
COPY src/Aerie.Web/apps/home/package.json src/Aerie.Web/apps/home/
COPY src/Aerie.Web/apps/modeler/package.json src/Aerie.Web/apps/modeler/
# The shared packages are workspaces too: `npm ci` reads the lockfile, finds a
# link: entry for each, and fails outright if that package.json is not on disk.
# Neither has a build script, so `--workspaces --if-present` below skips them
# and the consuming apps bundle their source.
COPY src/Aerie.Web/packages/lib/package.json src/Aerie.Web/packages/lib/
COPY src/Aerie.Web/packages/ui/package.json src/Aerie.Web/packages/ui/
RUN npm --prefix src/Aerie.Web ci

COPY src/Aerie.Web src/Aerie.Web
ARG AERIE_REVISION
ARG AERIE_SEQUENCE
ENV AERIE_REVISION=$AERIE_REVISION AERIE_SEQUENCE=$AERIE_SEQUENCE
RUN npm --prefix src/Aerie.Web run build --workspaces --if-present

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /App

# Copy everything (build context is the repo root - see compose.yaml / the
# release workflow - so Aerie.Api can reach its sibling Aerie.Web project)
COPY . ./
COPY --from=web-build /repo/src/Aerie.Api/wwwroot/apps ./src/Aerie.Api/wwwroot/apps

# Restore as distinct layers
RUN dotnet restore src/Aerie.Api/Aerie.Api.csproj

# Build and publish a release. The SPAs (from Aerie.Web) were already built above, so skip
# the MSBuild targets that would otherwise shell out to npm (unavailable here).
#
# SourceRevisionId is .NET's own mechanism rather than an env var on the runtime
# image: it appends "+<sha>" to AssemblyInformationalVersion, which puts the
# revision *in the binary*. That is the point - a revision the deployment can
# supply is a revision the deployment can get wrong, and every use of this value
# is a use that has to trust it (see Services/AerieRevision.cs).
ARG AERIE_REVISION
ARG AERIE_SEQUENCE
RUN dotnet publish src/Aerie.Api/Aerie.Api.csproj -c Release -o out -p:SkipDashboardBuild=true -p:SkipAdminBuild=true -p:SkipDesignBuild=true -p:SkipHomeBuild=true -p:SkipModelerBuild=true -p:SkipDocsBuild=true -p:SkipFamilyBuild=true -p:SkipAuthBuild=true -p:SkipChromeBuild=true -p:SourceRevisionId=$AERIE_REVISION -p:AerieSequence=$AERIE_SEQUENCE

# Build runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /App
COPY --from=build-env /App/out .
# Markdown source for DocsController/DocsService (Docs:Path in appsettings.Docker.json),
# not part of the published .NET output above.
COPY --from=build-env /App/docs ./docs
ENTRYPOINT ["dotnet", "Aerie.Api.dll"]
