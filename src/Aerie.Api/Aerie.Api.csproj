<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2"/>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3"/>
    <PackageReference Include="HADotNet.Core" Version="1.6.0"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2"/>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2"/>
    <PackageReference Include="Quartz" Version="3.15.1"/>
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.1"/>
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.15.1"/>
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1"/>
  </ItemGroup>

  <!--
    The Web SDK implicitly globs loose project-directory files as Content
    (CopyToPublishDirectory=PreserveNewest). Without this, the local secrets
    file gets copied into bin/ and any publish output, container images
    included - see .env.json usage in Program.cs.
  -->
  <ItemGroup>
    <Content Remove=".env.json"/>
  </ItemGroup>

  <!--
    Builds the Aerie.Web SPAs (dashboard and admin apps) into wwwroot/apps ahead of every build.
    Requires Node 18+ on PATH (see ../Aerie.Web/apps/*/.nvmrc) - `dotnet build`
    will fail with an old/missing npm otherwise. Skipped in Docker, where apps are
    built in their own stages and copied in (see Dockerfile.api).
  -->
  <ItemGroup>
    <DashboardSource Include="../Aerie.Web/apps/dashboard/src/**/*.*;../Aerie.Web/apps/dashboard/index.html;../Aerie.Web/apps/dashboard/package.json;../Aerie.Web/apps/dashboard/vite.config.ts"/>
  </ItemGroup>

  <Target Name="BuildDashboard" BeforeTargets="Build" Condition="'$(SkipDashboardBuild)' != 'true'"
          Inputs="@(DashboardSource)" Outputs="wwwroot/apps/dashboard/index.html">
    <Exec Command="npm install" WorkingDirectory="../Aerie.Web/apps/dashboard" Condition="!Exists('../Aerie.Web/apps/dashboard/node_modules')"/>
    <Exec Command="npm run build" WorkingDirectory="../Aerie.Web/apps/dashboard"/>
  </Target>

  <ItemGroup>
    <AdminSource Include="../Aerie.Web/apps/admin/src/**/*.*;../Aerie.Web/apps/admin/index.html;../Aerie.Web/apps/admin/package.json;../Aerie.Web/apps/admin/vite.config.ts"/>
  </ItemGroup>

  <Target Name="BuildAdmin" BeforeTargets="Build" Condition="'$(SkipAdminBuild)' != 'true'"
          Inputs="@(AdminSource)" Outputs="wwwroot/apps/admin/index.html">
    <Exec Command="npm install" WorkingDirectory="../Aerie.Web/apps/admin" Condition="!Exists('../Aerie.Web/apps/admin/node_modules')"/>
    <Exec Command="npm run build" WorkingDirectory="../Aerie.Web/apps/admin"/>
  </Target>

  <!-- Apps landing page (../Aerie.Web/index.html) - just a static file, no build step needed. -->
  <Target Name="CopyAppsIndex" BeforeTargets="Build"
          Inputs="../Aerie.Web/index.html" Outputs="wwwroot/apps/index.html">
    <Copy SourceFiles="../Aerie.Web/index.html" DestinationFolder="wwwroot/apps"/>
  </Target>
</Project>