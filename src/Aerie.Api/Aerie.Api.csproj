<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.42.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="HADotNet.Core" Version="1.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" />
    <PackageReference Include="Quartz" Version="3.15.1" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.1" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.15.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
  </ItemGroup>

  <!--
    The git identity of this build (docs/plans/version.md). The sha rides in on
    SourceRevisionId, which the SDK already appends to
    AssemblyInformationalVersion as "+<sha>" - there is no equivalent well-known
    property for an ordering, so the sequence travels as assembly metadata.
    Both are read back by Services/AerieRevision.cs.

    Conditioned so a local `dotnet build` - which passes neither - emits no
    empty attribute, leaving the reader to report `dev` rather than an
    ambiguous "". A dev machine's sha in a dev machine's artifact would answer
    nobody's question anyway, so nothing here shells out to git.
  -->
  <ItemGroup Condition="'$(AerieSequence)' != ''">
    <AssemblyMetadata Include="AerieSequence" Value="$(AerieSequence)" />
  </ItemGroup>

  <!--
    The Web SDK implicitly globs loose project-directory files as Content
    (CopyToPublishDirectory=PreserveNewest). Without this, the local secrets
    file gets copied into bin/ and any publish output, container images
    included - see .env.json usage in Program.cs.
  -->
  <ItemGroup>
    <Content Remove=".env.json" />
  </ItemGroup>

  <!--
    Builds the Aerie.Web SPAs into wwwroot/apps ahead of every build. Requires
    Node 22+ on PATH (see ../Aerie.Web/.nvmrc) - `dotnet build` will fail with
    an old/missing npm otherwise. Skipped in Docker, where the apps are built in
    the web-build stage and copied in (see Dockerfile.api).

    Aerie.Web is one npm workspace with one lockfile, so the install happens
    once, at the root, rather than per app: NpmInstall below is the only target
    that shells out to `npm install`, and every Build<App> depends on it. Each
    app then builds with `npm run build -w apps/<app>`, run from the workspace
    root because that is where node_modules lives.

    The Inputs/Outputs globs stay per-app - that is what keeps an edit to one
    app from rebuilding the other five. An app that starts consuming a shared
    package under ../Aerie.Web/packages/ must add that path to its own glob, or
    a library edit will not retrigger its incremental build.
  -->
  <Target Name="NpmInstall" Condition="!Exists('../Aerie.Web/node_modules')">
    <Exec Command="npm install" WorkingDirectory="../Aerie.Web" />
  </Target>

  <ItemGroup>
    <!-- The dashboard consumes @aerie/lib (the chart scales and the camera
         stream protocol it shares with admin), so packages/ is one of its
         inputs too. It does not consume @aerie/ui: the wall's palette is the
         circadian engine, which is deliberately not the design system. -->
    <DashboardSource Include="../Aerie.Web/apps/dashboard/src/**/*.*;../Aerie.Web/apps/dashboard/index.html;../Aerie.Web/apps/dashboard/package.json;../Aerie.Web/apps/dashboard/vite.config.ts;../Aerie.Web/packages/*/src/**/*.*;../Aerie.Web/packages/*/package.json" />
  </ItemGroup>

  <Target Name="BuildDashboard" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipDashboardBuild)' != 'true'" Inputs="@(DashboardSource)" Outputs="wwwroot/apps/dashboard/index.html">
    <Exec Command="npm run build -w apps/dashboard" WorkingDirectory="../Aerie.Web" />
  </Target>

  <ItemGroup>
    <!-- admin consumes @aerie/ui and @aerie/lib, so the shared packages are
         among its inputs: without this line a token edit would not retrigger an
         incremental admin build. Every app that adopts either needs the same
         line.
         Spelled as packages/*/src rather than packages/** so a stray
         node_modules under a package can never widen the glob. -->
    <AdminSource Include="../Aerie.Web/apps/admin/src/**/*.*;../Aerie.Web/apps/admin/index.html;../Aerie.Web/apps/admin/package.json;../Aerie.Web/apps/admin/vite.config.ts;../Aerie.Web/packages/*/src/**/*.*;../Aerie.Web/packages/*/package.json" />
  </ItemGroup>

  <Target Name="BuildAdmin" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipAdminBuild)' != 'true'" Inputs="@(AdminSource)" Outputs="wwwroot/apps/admin/index.html">
    <Exec Command="npm run build -w apps/admin" WorkingDirectory="../Aerie.Web" />
  </Target>

  <ItemGroup>
    <ModelerSource Include="../Aerie.Web/apps/modeler/src/**/*.*;../Aerie.Web/apps/modeler/index.html;../Aerie.Web/apps/modeler/package.json;../Aerie.Web/apps/modeler/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildModeler" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipModelerBuild)' != 'true'" Inputs="@(ModelerSource)" Outputs="wwwroot/apps/modeler/index.html">
    <Exec Command="npm run build -w apps/modeler" WorkingDirectory="../Aerie.Web" />
  </Target>

  <ItemGroup>
    <DocsSource Include="../Aerie.Web/apps/docs/src/**/*.*;../Aerie.Web/apps/docs/index.html;../Aerie.Web/apps/docs/package.json;../Aerie.Web/apps/docs/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildDocs" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipDocsBuild)' != 'true'" Inputs="@(DocsSource)" Outputs="wwwroot/apps/docs/index.html">
    <Exec Command="npm run build -w apps/docs" WorkingDirectory="../Aerie.Web" />
  </Target>

  <!--
    The design gallery. Like admin it consumes @aerie/ui, so the shared package
    is one of its inputs - and more so than admin's: this app exists to show the
    library, and a token edit that did not retrigger its build would leave the
    gallery describing a palette the apps no longer use.
  -->
  <ItemGroup>
    <DesignSource Include="../Aerie.Web/apps/design/src/**/*.*;../Aerie.Web/apps/design/public/**/*.*;../Aerie.Web/apps/design/index.html;../Aerie.Web/apps/design/package.json;../Aerie.Web/apps/design/vite.config.ts;../Aerie.Web/packages/*/src/**/*.*;../Aerie.Web/packages/*/package.json" />
  </ItemGroup>

  <Target Name="BuildDesign" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipDesignBuild)' != 'true'" Inputs="@(DesignSource)" Outputs="wwwroot/apps/design/index.html">
    <Exec Command="npm run build -w apps/design" WorkingDirectory="../Aerie.Web" />
  </Target>

  <!--
    The family shell PWA. Unlike the apps above, its public/ folder is a build
    input worth tracking: the manifest and icons are what make "Add to Home
    Screen" work, and editing one without touching src/ must still rebuild.
  -->
  <ItemGroup>
    <FamilySource Include="../Aerie.Web/apps/family/src/**/*.*;../Aerie.Web/apps/family/public/**/*.*;../Aerie.Web/apps/family/index.html;../Aerie.Web/apps/family/package.json;../Aerie.Web/apps/family/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildFamily" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipFamilyBuild)' != 'true'" Inputs="@(FamilySource)" Outputs="wwwroot/apps/family/index.html">
    <Exec Command="npm run build -w apps/family" WorkingDirectory="../Aerie.Web" />
  </Target>

  <!--
    The sign-in shell. Nothing else in the build depends on it, but a deploy
    that ships without it is a deploy where every redirect from the gate lands
    on a 404 - so it is built like the rest rather than left to a manual step.
  -->
  <ItemGroup>
    <AuthSource Include="../Aerie.Web/apps/auth/src/**/*.*;../Aerie.Web/apps/auth/index.html;../Aerie.Web/apps/auth/package.json;../Aerie.Web/apps/auth/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildAuth" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipAuthBuild)' != 'true'" Inputs="@(AuthSource)" Outputs="wwwroot/apps/auth/index.html">
    <Exec Command="npm run build -w apps/auth" WorkingDirectory="../Aerie.Web" />
  </Target>

  <!-- Apps landing page (../Aerie.Web/index.html) - just a static file, no build step needed. -->
  <Target Name="CopyAppsIndex" BeforeTargets="Build" Inputs="../Aerie.Web/index.html" Outputs="wwwroot/apps/index.html">
    <Copy SourceFiles="../Aerie.Web/index.html" DestinationFolder="wwwroot/apps" />
  </Target>

  <!--
    Logo app (../Aerie.Web/apps/logo) - a static Claude Design export
    (index.html + generated support.js), no npm build step needed.
  -->
  <ItemGroup>
    <LogoAppSource Include="../Aerie.Web/apps/logo/**/*.*" />
  </ItemGroup>

  <Target Name="CopyLogoApp" BeforeTargets="Build" Inputs="@(LogoAppSource)" Outputs="wwwroot/apps/logo/index.html">
    <Copy SourceFiles="@(LogoAppSource)" DestinationFolder="wwwroot/apps/logo" />
  </Target>
</Project>