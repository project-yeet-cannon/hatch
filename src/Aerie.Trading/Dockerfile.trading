# The trading silo's image (docs/plans/trading.md Phase 1).
#
# The build context is **this directory**, not the repository root - unlike
# ../Aerie.Api/Dockerfile.api, which needs the root so it can reach its sibling
# web project. That difference is the extraction seam expressed in the build:
# nothing outside src/Aerie.Trading/ can be COPYed into this image, so the day
# this becomes its own repository the Dockerfile is unchanged. A `COPY ../..`
# is not merely discouraged here; Docker refuses it.
#
# Two stages. The first builds a virtual environment with uv; the second is a
# clean runtime that carries the environment and the source and nothing else -
# no uv, no compiler, no linters, no test suite.

# uv is pinned by digest-bearing tag rather than installed by the curl-pipe
# script the README documents for a laptop: a moving installer inside an image
# build is a build that is not reproducible, which is the whole reason
# uv.lock is committed. Bump it deliberately, the same way
# scripts/versions.json's pins are bumped.
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv

# 3.12, matching .python-version - which is what `uv sync` resolves against, so
# a mismatch here would build a lockfile-correct environment for an interpreter
# the project was never checked on. -slim rather than -alpine: psycopg[binary]
# and uvloop ship manylinux wheels, and musl would send both to a source build
# that needs a compiler in the image.
FROM python:3.12-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

ENV UV_LINK_MODE=copy \
    # Precompile to .pyc during the build. Startup is marginally faster, but
    # the reason is the runtime's readOnlyRootFilesystem: without this, every
    # module is compiled on first import into a __pycache__ Python cannot
    # write, and the interpreter silently recompiles them on every start.
    UV_COMPILE_BYTECODE=1 \
    # Never reach out for an interpreter this image already has.
    UV_PYTHON_DOWNLOADS=never

# Dependencies first, and without the project, so an edit to the source below
# reuses this layer. --frozen fails rather than re-resolving if uv.lock has
# drifted from pyproject.toml; --no-dev leaves ruff, pyright and pytest out of
# an image that has no reason to carry them.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY aerie_trading ./aerie_trading
COPY alembic.ini ./

# The build's git identity (docs/plans/version.md). Declared here rather than
# before the first FROM, because a build arg is scoped to the stage that
# declares it and a global ARG is not inherited by the stages below it - the
# same trap ../Aerie.Api/Dockerfile.api's header writes out.
#
# Written *into the package* rather than exported as an environment variable on
# the runtime image, and that is the point rather than an implementation
# detail: a revision the deployment can supply is a revision the deployment can
# get wrong, and every consumer of this value is trusting it to describe the
# code that is actually running. This is the closest Python equivalent to the
# assembly attribute the .NET side gets from -p:SourceRevisionId. See
# aerie_trading/revision.py.
#
# Placed after `uv sync` so a new commit rebuilds one small file rather than
# re-resolving the dependency tree.
ARG AERIE_REVISION
ARG AERIE_SEQUENCE
RUN printf '{"revision":"%s","sequence":"%s","builtAt":"%s"}\n' \
      "${AERIE_REVISION}" \
      "${AERIE_SEQUENCE}" \
      "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" \
    > aerie_trading/build.json

# Installs the project itself into the environment built above, so the wheel
# metadata `aerie_trading.__version__` reads exists in the image.
RUN uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm AS runtime

# 1000:1000, matching the securityContext in
# deploy/cluster/trading/app/deployment.yaml and the .NET pods' own. Stated in
# both places on purpose: the manifest's runAsNonRoot is what the cluster
# enforces, and this is what makes the image work when it is run anywhere else.
RUN groupadd --gid 1000 trading \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin trading

WORKDIR /app

# The environment and the source together. uv installs the project itself in
# editable mode, so the source tree is part of the installation rather than a
# copy of it - taking one without the other produces an image whose imports
# fail at startup.
COPY --from=builder --chown=1000:1000 /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    # Unbuffered, or the JSON log lines this service writes sit in a pipe
    # buffer until it fills - which for a quiet control plane means the log
    # index is minutes behind the thing an operator is watching, and empty
    # exactly when a pod crashes before the buffer flushes.
    PYTHONUNBUFFERED=1 \
    # No .pyc written at runtime. UV_COMPILE_BYTECODE already produced them,
    # and the root filesystem is read-only in the cluster anyway.
    PYTHONDONTWRITEBYTECODE=1

USER 1000:1000

EXPOSE 8080

# The module, not a console script: the entrypoint names something that exists
# in the source tree and runs identically outside the image.
ENTRYPOINT ["python", "-m", "aerie_trading.control"]
