    {
      "id": 21,
      "type": "state-timeline",
      "title": "Flux delivery objects: Ready",
      "description": "Every object on the path from a push to a running pod, as a Ready/Not ready band.\n\nexported_namespace, not namespace: the PodMonitor that scrapes Flux adds its own `namespace` label (always flux-system, the pod's), which wins the collision and pushes the reconciled object's own namespace out under the exported name. Any panel here that groups by `namespace` is grouping by the wrong thing and will look right while being wrong - see observability/config/alerts/flux.yaml for the same note.\n\nA gap in a band is not a failure: it is a series that stopped existing, which is what a deleted or renamed object looks like.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, exported_namespace, name) (\n  gotk_reconcile_condition{type=\"Ready\", status=\"True\", kind=~\"Kustomization|HelmRelease|GitRepository|OCIRepository|ImageRepository|ImagePolicy|ImageUpdateAutomation\"}\n)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{kind}} {{exported_namespace}}/{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Not ready",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "perPage": 20,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
