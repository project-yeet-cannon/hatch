          "expr": "(count(\n  label_replace(kube_pod_container_info{namespace=\"aerie\", container=\"files\"}, \"tag\", \"$1\", \"image_spec\", \".*:(.+)\")\n  * on (tag) group_left ()\n  aerie_flux_image_policy_latest_tag{name=\"kiosk-files\"}\n) or vector(0))\n/\ncount(kube_pod_container_info{namespace=\"aerie\", container=\"files\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
