    {
      "id": 11,
      "type": "table",
      "title": "Build and test (ci.yml)",
      "description": "Runs of this workflow on main, newest first, within the dashboard's time range - widen the range to see further back. 'commit' is the SHA the run built, so this is the panel that says whether the commit at the top of this dashboard was built at all.\n\nThis half of the dashboard is GitHub's, which makes it the slower half by design: the datasource may serve a cached response for up to five minutes. That is fine for run history and is exactly why the Now row above reads Prometheus rather than GitHub.",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "github"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "github"
          },
          "queryType": "Workflow_Runs",
          "owner": "$owner",
          "repository": "$repo",
          "options": {
            "workflow": "ci.yml",
            "branch": "main"
          }
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "duration",
            "replaceFields": false,
            "binary": {
              "left": "updated_at",
              "operator": "-",
              "right": "run_started_at"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "run_started_at",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "id": true,
              "name": true,
              "url": true,
              "workflow_id": true,
              "head_branch": true,
              "created_at": true,
              "updated_at": true
            },
            "includeByName": {},
            "indexByName": {
              "run_started_at": 0,
              "run_number": 1,
              "conclusion": 2,
              "status": 3,
              "duration": 4,
              "event": 5,
              "head_sha": 6,
              "html_url": 7
            },
            "renameByName": {
              "run_started_at": "started",
              "run_number": "run",
              "head_sha": "commit",
              "html_url": "url"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conclusion"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failure": {
                        "color": "red",
                        "index": 1
                      },
                      "cancelled": {
                        "color": "text",
                        "index": 2
                      },
                      "skipped": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "commit"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    },
