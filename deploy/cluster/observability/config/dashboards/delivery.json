    {
      "id": 35,
      "type": "stat",
      "title": "restic: newest snapshot",
      "description": "Age of the last successful run of the aerie-backup CronJob - the pg_dump of both databases plus the /aerie/* parameter export, written to the S3 repository and the house share. Not the age of a snapshot read back out of either repo: this is the writer reporting success, and the verify panel to the right is the half that proves the bytes are readable. Turns orange at 26h (a run has been missed) and red at 36h, which is where ResticBackupTooOld fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"aerie\", cronjob=\"aerie-backup\"}",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          },
          "mappings": [],
          "noValue": "No data - the series is absent, which is what backup.yaml's absent() rules alert on"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
