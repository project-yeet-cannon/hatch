{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheWalBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<WAL_BUCKET>"
    },
    {
      "Sid": "ReadWriteWalAndBaseBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::<WAL_BUCKET>/*"
    }
  ]
}
