{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndConfigureTheBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::<LONGHORN_BUCKET>"
    },
    {
      "Sid": "ManageAerieUsersAndTheirInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:CreateUser",
        "iam:TagUser",
        "iam:PutUserPolicy",
        "iam:GetUserPolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:user/aerie-*"
    },
    {
      "Sid": "AssertTheExitCriteriaWithoutHoldingAnyoneElsesKeys",
      "Effect": "Allow",
      "Action": "iam:SimulatePrincipalPolicy",
      "Resource": "*"
    }
  ]
}
