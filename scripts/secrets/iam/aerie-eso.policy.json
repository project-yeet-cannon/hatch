{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheParameterTree",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter<PARAMETER_PREFIX>",
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter<PARAMETER_PREFIX>/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringValuesViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.<AWS_REGION>.amazonaws.com"
        }
      }
    }
  ]
}
